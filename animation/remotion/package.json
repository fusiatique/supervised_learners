{
  "name": "neuroai-animation",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "typecheck": "tsc --noEmit",
    "build:player": "esbuild src/player.tsx --bundle --minify --outfile=../media/scene01-player.js",
    "render": "remotion render src/index.tsx Scene01-HumanVsComputer ../media/scene01-human-vs-computer.mp4 --codec=h264 --muted",
    "build:scene02": "esbuild src/player02.tsx --bundle --minify --outfile=../media/scene02-player.js",
    "render:scene02": "remotion render src/index.tsx Scene02-RiskAndAddiction ../media/scene02-risk-and-addiction.mp4 --codec=h264 --muted",
    "check:scene02": "esbuild scripts/check-scene02.tsx --bundle --platform=node --packages=external --outfile=node_modules/.cache/check-scene02.cjs && node node_modules/.cache/check-scene02.cjs",
    "build:scene03": "esbuild src/player03.tsx --bundle --minify --outfile=../media/scene03-player.js",
    "render:scene03": "remotion render src/index.tsx Scene03-AddictionAndRewardLearning ../media/scene03-addiction-and-reward-learning.mp4 --codec=h264 --muted",
    "check:scene03": "esbuild scripts/check-scene03.tsx --bundle --platform=node --packages=external --outfile=node_modules/.cache/check-scene03.cjs && node node_modules/.cache/check-scene03.cjs",
    "build:scene04": "esbuild src/player04.tsx --bundle --minify --outfile=../media/scene04-player.js",
    "render:scene04": "remotion render src/index.tsx Scene04-MesocorticolimbicIntroduction ../media/scene04-mesocorticolimbic-introduction.mp4 --codec=h264 --muted",
    "check:scene04": "esbuild scripts/check-scene04.tsx --bundle --platform=node --packages=external --outfile=node_modules/.cache/check-scene04.cjs && node node_modules/.cache/check-scene04.cjs",
    "build:scene05": "esbuild src/player05.tsx --bundle --minify --outfile=../media/scene05-player.js",
    "render:scene05": "remotion render src/index.tsx Scene05-DopamineRewardPredictionErrors ../media/scene05-dopamine-reward-prediction-errors.mp4 --codec=h264 --muted",
    "check:scene05": "esbuild scripts/check-scene05.tsx --bundle --platform=node --packages=external --outfile=node_modules/.cache/check-scene05.cjs && node node_modules/.cache/check-scene05.cjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "@remotion/player": "4.0.484",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.484"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "esbuild": "0.25.5",
    "typescript": "5.8.3"
  }
}
